{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb", "maxDuration": 60 }
    },
    { "src": "webapp/static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/docs", "dest": "/api/index.py" },
    { "src": "/openapi.json", "dest": "/api/index.py" },
    {
      "src": "/vendor/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/webapp/static/vendor/$1"
    },
    {
      "src": "/support.js",
      "headers": { "cache-control": "public, max-age=3600" },
      "dest": "/webapp/static/support.js"
    },
    { "src": "/(.*)", "dest": "/webapp/static/index.html" }
  ]
}
